# syntax=docker/dockerfile:1

# Image de production : le code est embarqué (pas de volume de sources),
# les dépendances et les assets sont construits ici.
# Deux cibles : "app" (PHP-FPM) et "web" (nginx + fichiers publics).

# --- Dépendances PHP (sans les paquets de dev) ---
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --prefer-dist \
    --no-scripts --no-autoloader --ignore-platform-reqs

# --- Assets Vite/Tailwind (Tailwind lit les vues du framework et de l'app) ---
FROM node:22-bookworm-slim AS assets
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci
COPY vite.config.js postcss.config.js tailwind.config.js ./
COPY resources ./resources
COPY app ./app
COPY --from=vendor /app/vendor ./vendor
RUN npm run build

# --- Application : PHP-FPM ---
FROM php:8.3-fpm AS app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    && docker-php-ext-configure gd --with-jpeg --with-freetype \
    && docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd zip opcache \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY docker/php/php.prod.ini /usr/local/etc/php/conf.d/zz-app.ini
COPY docker/php/entrypoint.sh /usr/local/bin/entrypoint.sh

WORKDIR /var/www/html

COPY --from=vendor /app/vendor ./vendor
COPY . .
COPY --from=assets /app/public/build ./public/build

# public/storage pointe vers le volume de stockage (photos, logos) ;
# storage/ est un volume en production, l'entrypoint en garantit la structure.
RUN composer dump-autoload --optimize --no-dev \
    && ln -s /var/www/html/storage/app/public public/storage \
    && mkdir -p storage/app/public storage/app/private storage/fonts \
        storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["entrypoint.sh"]
CMD ["php-fpm"]

# --- Serveur web : nginx avec les fichiers publics de l'image "app" ---
FROM nginx:alpine AS web
COPY docker/nginx/default.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/html/public /var/www/html/public
