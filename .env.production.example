# Modèle pour le serveur de production : copier en .env.production (ignoré par git)
# et renseigner les valeurs. Les mots de passe ne doivent contenir ni espace ni guillemet.

APP_NAME="Gestion Personnel"
APP_ENV=production
# Générer avec : docker compose -f docker-compose.prod.yml --env-file .env.production run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Adresse publique du site
APP_URL=https://rh.exemple.com

# HTTPS (Caddy). Deux cas :
#  - Domaine public pointant vers ce serveur, ports 80 et 443 ouverts sur internet :
#    APP_DOMAIN = le domaine, APP_TLS = e-mail de contact. Certificat Let's Encrypt
#    obtenu et renouvelé automatiquement.
#  - Réseau interne sans domaine public : APP_DOMAIN = nom ou IP du serveur,
#    APP_TLS=internal (certificat local, avertissement dans les navigateurs).
APP_DOMAIN=rh.exemple.com
APP_TLS=admin@exemple.com
# Ports publiés sur le serveur (laisser 80 et 443 pour Let's Encrypt)
HTTP_PORT=80
HTTPS_PORT=443

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gestion_personnel
DB_USERNAME=gestion_personnel
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# À renseigner avec le SMTP du client : sans cela, la réinitialisation
# de mot de passe échoue.
MAIL_MAILER=smtp
MAIL_HOST=smtp.exemple.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=rh@exemple.com
MAIL_FROM_NAME="Gestion Personnel"
